{
  "schemaVersion": 2,
  "name": "curvesmash",
  "tracks": [
    {
      "name": "secp256k1-ecdlp",
      "description": "Recover x from Q = [x]P on secp256k1.",
      "category": "cryptanalysis",
      "mode": "pareto",
      "promotionMode": "manual",
      "direction": "-",
      "objectives": [
        {
          "name": "time_log2",
          "direction": "-"
        }
      ],
      "paretoPolicies": {
        "scoring": {
          "version": "classical-group-work-v2"
        },
        "validity": {
          "version": "exploratory-single-review-v1"
        }
      },
      "editablePaths": [
        "tracks/secp256k1-ecdlp/submission"
      ],
      "setupCommand": [
        "llm-verifier",
        "intake",
        "--root",
        "tracks/secp256k1-ecdlp",
        "--out",
        ".yukon/secp256k1-ecdlp/intake.json"
      ],
      "benchmarkCommand": [
        "llm-verifier",
        "finalize",
        "--intake",
        ".yukon/secp256k1-ecdlp/intake.json",
        "--initial",
        ".yukon/secp256k1-ecdlp/initial.json",
        "--initial-review",
        ".yukon/secp256k1-ecdlp/review.json",
        "--score",
        ".yukon/secp256k1-ecdlp/score.json",
        "--dossier",
        ".yukon/secp256k1-ecdlp/dossier.json"
      ],
      "scorePath": ".yukon/secp256k1-ecdlp/score.json",
      "maxSubmissionBytes": 262144,
      "runner": {
        "provider": "github-actions",
        "workflow": "secp256k1-ecdlp.yml",
        "scoreArtifactName": "benchmark-score",
        "maxConcurrentWorkflows": 2
      }
    },
    {

{
 "purpose": "Exercise the rare paths of measurement/step.c that a production-parameter sample does not reach: restarts at distinguished points, abandonment at the trail cap, and false filter matches (8-bit filters) that launch exact cycle checks, including distinguished points first reached during a look-ahead (ahead_dps)",
 "builds": "measurement/step.c compiled with the flags below (organizer image and flags), walk_ref.py run with the same values in its environment (ADDER_BITS, B, DP_BITS, CAP_PERIODS, FILTER_BITS)",
 "inputs": "walk_ref.py gen with ADDER_BITS=6 B=4096, seed 7",
 "runs": [
  {
   "flags": "-DADDER_BITS=6 -DB=4096 -DDP_BITS=4",
   "batch_steps": 200,
   "walk_steps": 819200,
   "kernel": {
    "two_cycles": 1856,
    "long_cycles": 0,
    "dps": 49943,
    "ahead_dps": 0,
    "abandoned": 0,
    "exceptional": 0
   },
   "replica": {
    "walks": 4096,
    "batch_steps": 200,
    "mismatches": 0,
    "two_cycles": 1856,
    "long_cycles": 0,
    "dps": 49943,
    "ahead_dps": 0,
    "abandoned": 0
   }
  },
  {
   "flags": "-DADDER_BITS=6 -DB=4096 -DDP_BITS=12 -DCAP_PERIODS=1",
   "batch_steps": 200,
   "walk_steps": 819200,
   "kernel": {
    "two_cycles": 2100,
    "long_cycles": 10,
    "dps": 208,
    "ahead_dps": 0,
    "abandoned": 4092,
    "exceptional": 0
   },
   "replica": {
    "walks": 4096,
    "batch_steps": 200,
    "mismatches": 0,
    "two_cycles": 2100,
    "long_cycles": 10,
    "dps": 208,
    "ahead_dps": 0,
    "abandoned": 4092
   }
  },
  {
   "flags": "-DADDER_BITS=6 -DB=4096 -DDP_BITS=6 -DFILTER_MASK=0xffULL",
   "batch_steps": 200,
   "walk_steps": 819200,
   "kernel": {
    "two_cycles": 2047,
    "long_cycles": 24,
    "dps": 13743,
    "ahead_dps": 1406,
    "abandoned": 0,
    "exceptional": 0
   },
   "replica": {
    "walks": 4096,
    "batch_steps": 200,
    "mismatches": 0,
    "two_cycles": 2047,
    "long_cycles": 24,
    "dps": 13743,
    "ahead_dps": 1406,
    "abandoned": 0
   }
  }
 ]
}